{
  "ssg": "hugo",
  "mode": "hosted",
  "build": {
    "hugoVersion": "0.166.0",
    "rubyVersion": "3.4.8",
    "nodeVersion": "22",
    "denoVersion": "2.7.1",
    "preserved_paths": "node_modules/,resources/,.hugo_cache/",
    "environment": "",
    "source": "",
    "destination": "public",
    "baseURL": "/",
    "config": "",
    "configDir": "",
    "contentDir": "",
    "layoutDir": "",
    "themesDir": "",
    "theme": "",
    "logFile": "",
    "ignoreVendorPaths": "",
    "disableKinds": "",
    "buildDrafts": false,
    "buildExpired": false,
    "buildFuture": false,
    "cleanDestinationDir": false,
    "debug": false,
    "enableGitInfo": false,
    "gc": false,
    "i18nWarnings": false,
    "ignoreCache": false,
    "ignoreVendor": false,
    "log": false,
    "minify": false,
    "noChmod": false,
    "noTimes": false,
    "pathWarnings": false,
    "mem": false,
    "quiet": false,
    "templateMetrics": false,
    "templateMetricsHints": false,
    "verbose": false,
    "verboseLog": false,
    "use_beta_plugin": false,
    "includeGit": false,
    "preserveOutput": false,
    "environment_variables": [
      {
        "key": "HUGO_CACHEDIR",
        "value": "/usr/local/__site/src/.hugo_cache/"
      }
    ],
    "install_command": "npm i",
    "build_command": "npm run build",
    "output_path": "public",
    "manually_configure_urls": true
  }
}